<% layout("/layouts/boilerplate.ejs") %>


    <div class="row">
        <div class="col-8 offset-3">
            <h3>Additional Details : </h3>
        </div>

        <div class="col-6 offset-3">
            <div class="card show-card">
                <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image">
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b> <br> <hr> 
                         <%= listing.description %> <br> <hr>
                        Price: &#8377 <%= listing.price.toLocaleString("en-IN") %> <br>
                        Country:  <%= listing.country %> <br>
                        Location:  <%= listing.location %>
                    </p>
                </div>
            </div>
        </div>
    
        <div class="btns">
            <a  class="btn btn-dark offset-3 col-1 edit-btn mb-5" href="/listings/<%= listing._id %>/edit">Edit</a>

                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
            <button class="btn btn-dark offset-3 dlt-btn">Delete</button>
        </form>
        </div>
    </div>